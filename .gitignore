# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.env

# --- Python & ML Service ---
ml/.venv/
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
ml/build_log.txt
ml/dataset/so_*.csv
ml/dataset/survey_results_public.csv
ml/dataset/rolecompass_training.csv
*.pdf
*.pkl

# --- Node & Frontend ---
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Spring Boot & Java (Maven) ---
backend/target/
rolecompass-backend/target/
**/target/
*.class
*.jar
*.war
.mvn/
!.mvn/wrapper/maven-wrapper.jar

# --- Database & Docker Volumes ---
postgres_data/
**/postgres_data/

# --- IDEs, OS & Editors ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Private / Internal Reference Docs (never pushed to GitHub) ---
private/
*.docx
docs/*.txt
