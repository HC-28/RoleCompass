# ==============================================================================
# RoleCompass — Environment Configuration
#
# Usage:
#   1. Copy this file:    cp .env.example .env
#   2. Edit .env with your values (especially JWT_SECRET_KEY in production)
#   3. Run:               docker compose up --build
#
# For local dev (without Docker), set these in your shell or .env.local
# ==============================================================================

# ── Database ───────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=password

# ── JWT Security ───────────────────────────────────────────────────────────────
# IMPORTANT: Generate a new key for any non-local deployment:
#   openssl rand -hex 32
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ── Local-only (not used inside Docker containers) ─────────────────────────────
# These are only needed when running services directly on your host machine.
# DB_URL=jdbc:postgresql://localhost:5433/rolecompass
# ML_SERVICE_URL=http://localhost:8000
# PORT=8080
